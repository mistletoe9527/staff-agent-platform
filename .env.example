# ============ 平台 ============
# 对外端口
PORT=8787
# 数据目录（容器内固定 /data，由 volume 持久化）
DATA_DIR=./data
# 管理后台登录口令，必须改（至少 8 位）
ADMIN_PASSWORD=change-me-please
# 会话签名密钥，留空则由 ADMIN_PASSWORD 派生；建议单独设置随机串
ADMIN_SESSION_SECRET=
# 日志级别：info | warn | error
LOG_LEVEL=info

# 对外可访问地址，例如 https://agent.example.com
# 配置后绑定流程会额外提供二维码；不配置只提供 6 位绑定码
PUBLIC_BASE_URL=

# ============ 飞书 ============
# 关闭后平台仍可启动，管理后台可用，但不接收飞书消息（本地联调用）
FEISHU_ENABLED=true
# 飞书自建应用凭证；不要把真实值提交到仓库
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书开放平台域名：国内 open.feishu.cn，Lark 国际 open.larksuite.com
FEISHU_OPEN_BASE=https://open.feishu.cn
# 飞书网页授权回调地址，例如 https://agent.example.com/bind/callback
# 必须与飞书后台「安全设置 - 重定向 URL」一致；配置后可用手机扫码一步绑定
FEISHU_OAUTH_REDIRECT_URI=

# ============ 任务与 trace ============
# 单次任务最长执行时间（秒）
AGENT_TIMEOUT_SEC=1800
# 长轮询挂起时长（毫秒），要小于反向代理的空闲超时
POLL_HOLD_MS=25000
# 任务租约（毫秒）：网关掉线后多久回收任务
RUN_LEASE_MS=120000
# 任务最大重投次数
RUN_MAX_ATTEMPTS=3
# 在线判定窗口（秒）
ONLINE_WINDOW_SEC=60
# 绑定码有效期（秒）
ENROLL_TTL_SEC=300
# trace 明细保留天数，过期只保留任务级记录与聚合统计
TRACE_RETENTION_DAYS=7
# 单条 trace 摘要最大字符数
TRACE_MAX_SUMMARY_CHARS=2000
